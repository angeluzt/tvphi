// TVPHI — esquema de datos
//
// Producto actual: cuentas, historias (Story*), sprites, cupos IA (AiCredential / AppSetting).
//
// Lo que sigue (Channel, chat, points, donations, subscriptions, Scene de Studio…)
// es LEGADO de la etapa de streaming: se conserva en el schema para no romper
// migraciones ya aplicadas en producción. No hay UI ni rutas que lo usen.
// Una migración destructiva futura puede tirar esas tablas con cuidado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Usuarios y canales
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Cuándo cambió la contraseña por última vez. Las sesiones firmadas antes
  /// de esta fecha dejan de valer: es lo que echa a quien tuviera la cuenta
  /// abierta. Nulo = nunca la ha cambiado, así que no invalida nada.
  passwordChangedAt DateTime?
  /// Cuándo se comprobó que el correo es suyo. Nulo = sin comprobar, y
  /// entonces no puede usar nada que gaste dinero. Se puede entrar y usar el
  /// editor igual: verificar sirve para que nadie queme la clave de OpenAI con
  /// direcciones de usar y tirar, no para cerrarle la puerta a quien se apunta.
  emailVerifiedAt DateTime?

  channel        Channel?
  templates      Template[]
  storyProjects  StoryProject[]
  storyCharacters StoryCharacter[]
  storySeries     StorySeries[]
  spriteCharacters SpriteCharacter[]
  spriteAtlases    SpriteAtlas[]
  aiCredential    AiCredential?
  chatMessages   ChatMessage[]
  pointsBalances PointsBalance[]
  pointsTx       PointsTransaction[] @relation("PointsTxUser")
  redemptions    RewardRedemption[]
  donations      Donation[]          @relation("DonationFromUser")
  subscriptions  Subscription[]      @relation("SubscriberUser")
  memberships    ChannelMember[]
  issuedModActions ModerationAction[] @relation("ModActor")
  targetModActions ModerationAction[] @relation("ModTarget")
  passwordResets PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
}

model Channel {
  id          String   @id @default(cuid())
  slug        String   @unique // aparece en /[slug]
  title       String
  description String?  @db.Text
  category    String?
  bannerUrl   String?
  accentColor String?  // permite personalizar el color del canal
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Ingest: clave de stream (RTMP para OBS) + id del input en el proveedor de medios
  streamKey     String  @unique @default(cuid())
  mediaInputId  String?
  playbackUrl   String?
  whipUrl       String?
  isLive        Boolean @default(false)
  lastLiveAt    DateTime?

  // Ajustes de chat
  subscriberOnlyChat Boolean @default(false)
  slowModeSeconds    Int     @default(0)
  emoteOnly          Boolean @default(false)

  scenes        Scene[]
  overlayTokens OverlayToken[]
  streamSessions StreamSession[]
  chatMessages  ChatMessage[]
  members       ChannelMember[]
  rewards       ChannelReward[]
  redemptions   RewardRedemption[]
  donations     Donation[]
  subscriptions Subscription[]
  pointsBalances PointsBalance[]
  pointsTx      PointsTransaction[]
  modActions    ModerationAction[]
  adAccruals    AdRevenueAccrual[]
  payouts       Payout[]
  emotes        ChannelEmote[]
}

// Rol de un usuario dentro de un canal concreto
enum ChannelRole {
  VIEWER
  SUBSCRIBER
  MODERATOR
  BROADCASTER
}

model ChannelMember {
  id        String      @id @default(cuid())
  channelId String
  userId    String
  role      ChannelRole @default(VIEWER)
  createdAt DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId, role])
}

// ---------------------------------------------------------------------------
// Studio: escenas y capas (el "OBS en el navegador")
// ---------------------------------------------------------------------------

model Scene {
  id        String   @id @default(cuid())
  channelId String
  name      String
  order     Int      @default(0)
  // Capas serializadas como JSON: [{type,transform,props}], validadas con Zod en la app.
  layers    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, order])
}

// Emote personalizado de un canal. La imagen se guarda como data URL (base64) para
// que persista sin depender de almacenamiento de objetos; los emotes son pequeños.
model ChannelEmote {
  id        String   @id @default(cuid())
  channelId String
  code      String // p.ej. "phiLove" -> se escribe :phiLove: en el chat
  imageUrl  String   @db.Text
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, code])
  @@index([channelId])
}

// Plantilla con nombre: una distribución de escenas/capas guardada para reutilizar
// en varios videos. Se guarda como un único JSON (poco almacenamiento).
model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      Json     // array de Scene serializado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Proyecto de "Historias narradas": metadatos (slides con texto/movimiento/transición,
// capas de audio con volumen/tiempo) en un único JSON. Las imágenes y audios pesados
// NO se suben: viven en IndexedDB del navegador. Poco almacenamiento en la BD.
model StoryProject {
  id        String   @id @default(cuid())
  userId    String
  // Capítulo de una serie. Opcional: los proyectos de antes siguen sin serie.
  seriesId  String?
  name      String
  data      Json     // { slides[], audioLayers[], narrationVolume } serializado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  series StorySeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([seriesId])
}

// Ficha de un personaje: sus imágenes base, cómo es, y con qué prompt se creó.
// De momento es solo una referencia para el usuario (una "biblia de personajes"
// de toda la vida). El prompt y los ajustes se guardan pensando en que más
// adelante se pueda pedir a una IA "hazme a este personaje haciendo X".
// Una serie: agrupa capítulos (proyectos) y personajes. Guarda además el estilo
// común —modelo, semilla y prefijo de prompt— que es lo que hace que los
// capítulos se parezcan entre sí.
// La clave de un proveedor de IA, de cada usuario. Cifrada: aquí solo hay texto
// ilegible, y la interfaz nunca la recibe de vuelta.
model AiCredential {
  id        String   @id @default(cuid())
  userId    String   @unique
  provider  String   // "openai"
  encrypted String   // iv.tag.dato (AES-256-GCM)
  hint      String   // "••••1a2b", para reconocerla
  // Un modelo por tarea: no todos sirven para todo (los baratos de texto no
  // hacen audio). { texto, imagen, voz }
  models    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StorySeries {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      Json     // { description, style, model, seed, notes }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects   StoryProject[]
  characters StoryCharacter[]

  @@index([userId])
}

model StoryCharacter {
  id        String   @id @default(cuid())
  userId    String
  // Opcional a propósito: los personajes de antes se quedan sin serie y se
  // siguen viendo. Al borrar una serie no se borran, solo se sueltan.
  seriesId  String?
  name      String
  data      Json     // { description, prompt, model, seed, params, notes, images[] }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  series          StorySeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  spriteCharacter SpriteCharacter?

  @@index([userId])
  @@index([seriesId])
}

model StreamSession {
  id         String    @id @default(cuid())
  channelId  String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  peakViewers Int      @default(0)
  source     String    @default("studio") // studio | obs

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId])
}

// Token para exponer un overlay como browser-source (OBS) o dentro del compositor
model OverlayToken {
  id        String   @id @default(cuid())
  channelId String
  token     String   @unique @default(cuid())
  label     String   @default("Overlay principal")
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Chat y moderación
// ---------------------------------------------------------------------------

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  deleted   Boolean  @default(false)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

enum ModActionType {
  TIMEOUT
  BAN
  UNBAN
  BLOCK
  UNBLOCK
  DELETE_MESSAGE
}

model ModerationAction {
  id        String        @id @default(cuid())
  channelId String
  actorId   String
  targetId  String
  type      ModActionType
  reason    String?
  // Para TIMEOUT: hasta cuándo dura
  expiresAt DateTime?
  createdAt DateTime      @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  actor   User    @relation("ModActor", fields: [actorId], references: [id], onDelete: Cascade)
  target  User    @relation("ModTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([channelId, targetId])
}

// ---------------------------------------------------------------------------
// Puntos (ledger) y rewards
// ---------------------------------------------------------------------------

// Saldo materializado por (usuario, canal). La verdad está en PointsTransaction;
// este registro es un acumulado para lecturas rápidas.
model PointsBalance {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

enum PointsTxType {
  AD_ACCRUAL       // acumulación simulada por publicidad
  AWARD            // otorgado por broadcaster/mod
  DONATION_BONUS   // bonus por donación
  REDEEM           // gasto al canjear un reward
  ADJUSTMENT       // ajuste manual
  PAYOUT           // retiro (stub)
}

model PointsTransaction {
  id        String       @id @default(cuid())
  channelId String
  userId    String
  type      PointsTxType
  amount    BigInt       // positivo = ganancia, negativo = gasto
  memo      String?
  createdAt DateTime     @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation("PointsTxUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, userId, createdAt])
}

enum RewardAction {
  SHOW_MESSAGE   // muestra un mensaje del espectador en el overlay
  PLAY_SOUND     // reproduce un sonido/animación
  CHANGE_SCENE   // pide cambio de escena
  CUSTOM         // acción personalizada (payload libre)
}

model ChannelReward {
  id        String       @id @default(cuid())
  channelId String
  title     String
  cost      Int
  action    RewardAction @default(SHOW_MESSAGE)
  // Config extra: color, sonido, duración, requiere texto del usuario, etc.
  config    Json         @default("{}")
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())

  channel     Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([channelId])
}

enum RedemptionStatus {
  PENDING
  COMPLETED
  REFUNDED
}

model RewardRedemption {
  id        String           @id @default(cuid())
  channelId String
  rewardId  String
  userId    String
  userInput String?          @db.Text
  status    RedemptionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  channel Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  reward  ChannelReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// ---------------------------------------------------------------------------
// Donaciones y suscripciones
// ---------------------------------------------------------------------------

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
}

model Donation {
  id          String         @id @default(cuid())
  channelId   String
  fromUserId  String?
  displayName String         // nombre a mostrar en la alerta
  amountCents Int
  currency    String         @default("usd")
  message     String?        @db.Text
  status      DonationStatus @default(PENDING)
  provider    String         @default("stripe") // stripe | simulated
  providerRef String?
  createdAt   DateTime       @default(now())

  channel  Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  fromUser User?   @relation("DonationFromUser", fields: [fromUserId], references: [id])

  @@index([channelId, createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model Subscription {
  id          String             @id @default(cuid())
  channelId   String
  userId      String
  tier        Int                @default(1)
  status      SubscriptionStatus @default(ACTIVE)
  provider    String             @default("stripe")
  providerRef String?
  currentPeriodEnd DateTime?
  createdAt   DateTime           @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation("SubscriberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
}

// ---------------------------------------------------------------------------
// Monetización por publicidad (STUB) y retiros (STUB)
// ---------------------------------------------------------------------------

model AdRevenueAccrual {
  id           String   @id @default(cuid())
  channelId    String
  impressions  Int
  revenueCents Int
  pointsMinted BigInt
  createdAt    DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

model Payout {
  id          String       @id @default(cuid())
  channelId   String
  amountCents Int
  pointsBurned BigInt
  status      PayoutStatus @default(REQUESTED)
  note        String?
  createdAt   DateTime     @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// Ajustes globales de la app (cupo IA, etc.). Una fila por clave.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Token de un solo uso para restablecer contraseña (se guarda el hash, no el valor).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Igual que el de restablecer contraseña, y a propósito: mismo mecanismo, se
/// guarda el hash y no el token, caduca, y se marca usado para que el enlace
/// no valga dos veces. Va en su propia tabla para que caducar uno no toque al
/// otro: los plazos son muy distintos (1 hora frente a 2 días).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// El correo al que se mandó. Si para cuando vuelva el enlace la cuenta
  /// tiene otra dirección, el token ya no prueba nada y no se acepta.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Un sprite ya fabricado, guardado para volver a usarlo.
///
/// POR QUÉ EN LA BASE DE DATOS Y NO EN DISCO. El disco del servidor es
/// temporal: se borra en cada despliegue. Un sprite guardado ahí duraría hasta
/// el siguiente arreglo de otra cosa. Y meterlos en el repositorio obligaría a
/// desplegar la aplicación entera cada vez que se fabrica un pájaro.
///
/// QUÉ SE GUARDA: la TIRA, no la hoja original. Los fotogramas ya vienen
/// recortados con la misma caja, alineados y con transparencia; pegarlos en
/// fila deja un solo PNG que se pinta por trozos sin volver a procesar nada.
/// Guardar la hoja cruda obligaría a repetir el recorte en cada carga, y el
/// recorte depende de un umbral: la misma hoja podría salir distinta mañana.
model Sprite {
  id         String   @id @default(cuid())
  /// Cómo se llama en la biblioteca.
  nombre     String
  /// Lo que se le pidió al modelo, en inglés. Se guarda porque es lo que
  /// tendrá que leer la IA el día que elija sprites en vez de generarlos.
  que        String
  fotogramas Int
  /// A cuántos por segundo se ve bien. Se decide al fabricarlo, mirándolo.
  fps        Int
  vista      String   @default("lateral")
  direccion  String   @default("derecha")
  accion     String   @default("otro")
  anclaje    String   @default("centro")
  /// Tamaño de UN fotograma, no de la tira.
  ancho      Int
  alto       Int
  /// Los fotogramas en fila, en un PNG con transparencia.
  tira       Bytes
  /// Lo que ocupa. Está aquí para poder listar la biblioteca sin traerse los
  /// bytes de todos los sprites solo para contarlos.
  bytes      Int
  /// Quién lo fabricó. Sin relación a propósito: la biblioteca es común, y
  /// borrar una cuenta no debe llevarse por delante sprites que usa todo el
  /// mundo.
  creadoPor  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SpriteCharacter {
  id               String  @id @default(cuid())
  userId           String
  storyCharacterId String? @unique
  nombre           String
  descripcion      String  @db.Text
  referencia       Bytes
  bytesReferencia  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyCharacter StoryCharacter? @relation(fields: [storyCharacterId], references: [id], onDelete: SetNull)
  animaciones      SpriteAnimation[]
  @@index([userId, updatedAt])
}

model SpriteAnimation {
  id String @id @default(cuid())
  characterId String
  nombre String
  que String @db.Text
  fotogramas Int
  fps Int
  vista String
  direccion String
  accion String
  anclaje String
  croma String
  columnas Int
  filas Int
  anchoHoja Int
  altoHoja Int
  ancho Int
  alto Int
  celdas Json
  hojaOriginal Bytes
  hojaTrabajo Bytes?
  tira Bytes?
  atlasFrames Json?
  bytesOriginal Int
  bytesTrabajo Int
  bytesTira Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  character SpriteCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@index([characterId, updatedAt])
}

model SpriteAtlas {
  id String @id @default(cuid())
  userId String
  ancho Int @default(2048)
  alto Int @default(2048)
  png Bytes
  bytes Int
  cursorX Int @default(2)
  cursorY Int @default(2)
  altoFila Int @default(0)
  usados Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
