# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Secreto para firmar sesiones (JWT). Genera uno con: openssl rand -base64 32
# En producción es OBLIGATORIO: sin AUTH_SECRET la app no arranca.
AUTH_SECRET=dev-secret-change-me-please-0000000000000000

# ---- Correo (restablecer contraseña) ----
# Resend: https://resend.com — sin clave, en desarrollo el enlace sale en la consola del servidor.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=TVPHI <noreply@tudominio.com>

# ---- Base de datos (Postgres) ----
# Guarda solo la cuenta y el proyecto (escenas/capas). Los videos NO se suben:
# se graban y descargan en el navegador del usuario.
DATABASE_URL=postgresql://tvphi:tvphi@localhost:5432/tvphi?schema=public
# Railway (prod): una sola variable — Prisma lee DATABASE_URL:
# DATABASE_URL=${{Postgres.DATABASE_PRIVATE_URL}}
# (cambia "Postgres" si tu servicio se llama distinto)

# ---- OpenAI (servidor; no se muestra al usuario) ----
OPENAI_API_KEY=
# Modelos por defecto (opcionales; si no, gpt-5.6-luna / gpt-4o-mini-tts / gpt-image-2)
# OPENAI_MODEL_TEXTO=gpt-5.6-luna
# OPENAI_MODEL_IMAGEN=gpt-image-2
# OPENAI_MODEL_VOZ=gpt-4o-mini-tts
# OPENAI_VOICE=alloy
# OPENAI_BASE_URL=https://api.openai.com

# ---- Cupo IA + admins ----
STORY_DAILY_LIMIT=3
# Valor inicial si aún no se ha guardado desde /admin. Tras guardar en el panel,
# manda el valor de la base de datos.
# Correos admin (coma): sin cupo IA, eligen modelos, ven /admin
# STORY_QUOTA_EXEMPT_EMAILS=tu@email.com

# ---- Gasto de OpenAI (panel de admin) ----
# OJO: NO es la de arriba. Los costes viven bajo /v1/organization y piden una
# clave de ADMINISTRADOR de la organización, que se saca aparte en el panel de
# OpenAI. Sin ella, la sección de gasto lo dice y no enseña nada inventado.
# OPENAI_ADMIN_KEY=sk-admin-...
# OpenAI NO publica el saldo que queda, solo lo gastado. Si pones aquí lo que
# decides gastarte al mes, el panel resta y enseña «te queda».
# OPENAI_PRESUPUESTO_MENSUAL=25
# (Los días del panel de gasto van en UTC y no se puede cambiar: la API de
# costes de OpenAI solo agrupa por día UTC, no da el detalle por horas.)

# ---- Captcha en el registro (Cloudflare Turnstile) ----
# Gratis y sin tope que importe. NO hace falta tener el dominio en Cloudflare:
# basta una cuenta gratuita en dash.cloudflare.com → Turnstile → Add site.
# Sin estas dos claves el captcha queda APAGADO y el registro sigue funcionando;
# lo que protege mientras tanto es el tope por IP, que no depende de nadie.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
