# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Secreto para firmar sesiones (JWT). Genera uno con: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-please-0000000000000000

# ---- Base de datos (Postgres) ----
DATABASE_URL=postgresql://tvphi:tvphi@localhost:5432/tvphi?schema=public

# ---- Redis (realtime pub/sub, presencia, rate-limit) ----
REDIS_URL=redis://localhost:6379

# ---- Capa de medios ----
# mock | cloudflare
MEDIA_PROVIDER=mock
# Solo para provider=cloudflare:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
# URL de un HLS de muestra que el MockProvider devuelve como playback en dev:
MOCK_PLAYBACK_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# ---- Stripe (donaciones / suscripciones) ----
# En dev puedes dejarlo vacío: el flujo cae en modo simulado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=false

# ---- Monetización ----
# Valor en USD de 1000 puntos (para mostrar el equivalente del ledger).
POINTS_PER_USD=1000
